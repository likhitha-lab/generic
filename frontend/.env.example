# Base URL of the backend API (no trailing slash). This MUST be an absolute
# URL, not a path - if it's missing, the app will throw an error on startup
# rather than silently sending requests to the frontend's own origin.
#
# Local dev examples:
#   VITE_API_URL=http://127.0.0.1:8000   # uvicorn app.main:app --reload (default port)
#   VITE_API_URL=http://localhost:8080   # uvicorn app.main:app --reload --port 8080
# Production example (Cloud Run):
#   VITE_API_URL=https://resumebuilder-backend-xxxxx-uc.a.run.app
VITE_API_URL=http://127.0.0.1:8000

# Authentication is JWT-based (login/register), not a shared API key - there
# is no frontend secret to configure. Tokens are issued by POST /api/auth/login
# and stored client-side (see src/api/tokenStorage.ts); nothing here needs to
# know about JWT_SECRET_KEY or any other backend secret.
