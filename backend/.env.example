# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- CORS - comma separated list of allowed frontend origins ---
# Production: the exact Cloud Run URL(s) of the frontend, e.g.
# https://resumebuilder-frontend-xxxxx-uc.a.run.app - never "*" once
# allow_credentials is on (see app/main.py).
ALLOWED_ORIGINS=http://localhost:5173

# --- Public URLs (informational/CORS only - nothing else reads these) ---
FRONTEND_URL=
BACKEND_URL=

# --- Rate limiting ---
RATE_LIMIT=10/minute
AUTH_RATE_LIMIT=5/minute

# --- Database (PostgreSQL only - no SQLite) ---
# Local dev (default): the `db` service in docker-compose.yml - `docker
# compose up` gives you this automatically, no manual Postgres install.
# Host port is 5433, not Postgres's usual 5432, to avoid clashing with any
# other local Postgres you might already have running - only matters if
# you're running this backend OUTSIDE docker compose (compose's internal
# network always reaches it at db:5432 regardless of the host port; see
# docker-compose.yml's `backend` service, which sets DATABASE_URL itself).
DATABASE_URL=postgresql+psycopg://resumebuilder:resumebuilder@localhost:5433/resumebuilder
# Neon PostgreSQL (production on GCP) - a fully external, serverless
# Postgres provider, not a GCP resource; plain TCP/TLS, no proxy/socket
# needed (see DEPLOYMENT_GCP.md §12):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<your-neon-host>/<db>?sslmode=require
# Azure SQL (if deploying there instead):
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800

# --- JWT auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seeded admin (created once on first startup if no admin exists yet) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- File storage ---
# "local" (default, no setup required), "gcs" (Google Cloud Storage), or
# "azure" (Azure Blob Storage).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_data/blobs

# --- Google Cloud Storage (only used when STORAGE_BACKEND=gcs) ---
# e.g. GCS_BUCKET_NAME=resume_bucket08 - the bucket must already exist with
# Resume_uploads/ and Resume_output/ as the two top-level folders (see
# app/utils/files.py and DEPLOYMENT_GCP.md).
GCS_BUCKET_NAME=
GOOGLE_CLOUD_PROJECT=
# Leave blank on Cloud Run - the service's own service account is used
# automatically. Set only for local dev against a real bucket, pointing at a
# downloaded service-account key file (or just run
# `gcloud auth application-default login` instead and leave this blank too).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure Blob Storage (only used when STORAGE_BACKEND=azure) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

# --- Azure Key Vault (optional - leave blank to use the plain env vars above) ---
AZURE_KEY_VAULT_URL=

# --- Application Insights (optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Resume upload/convert pipeline debug logging (optional, verbose) ---
# When true, logs raw extracted text, the full Gemini prompt, Gemini's raw
# response, and the final JSON for every upload/convert - for diagnosing a
# specific bad resume. Off by default (logs resume content).
DEBUG_RESUME_PIPELINE=false
